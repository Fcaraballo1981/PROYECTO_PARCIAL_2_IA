# Copiá este archivo como .env y completá las claves necesarias.
GEMINI_API_KEY=

# En Vercel, conectá Neon desde Marketplace. La integración agrega DATABASE_URL.
# Localmente dejala vacía para continuar usando SQLite.
DATABASE_URL=

# Configuración opcional
GEMINI_MODEL=gemini-3.5-flash-lite

# Acceso administrativo opcional
ADMIN_USERNAME=
ADMIN_PASSWORD=
